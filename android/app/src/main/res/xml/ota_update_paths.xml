<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 兼容 ota_update 插件默认路径（根缓存目录） -->
    <cache-path name="apk_cache" path="."/>
    <external-cache-path name="apk_external_cache" path="."/>
